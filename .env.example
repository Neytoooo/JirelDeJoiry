# ==============================================================================
# CONFIGURATION DES VARIABLES D'ENVIRONNEMENT — JIREL DE JOIRY
# ==============================================================================

# URI de connexion MongoDB Atlas (à renseigner dans les variables de projet Vercel)
# Format : mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
MONGODB_URI=

# Note : Si MONGODB_URI n'est pas configuré, le site fonctionne automatiquement
# en mode local (persistance via localStorage dans le navigateur).
