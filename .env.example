# Configuration des alertes et notifications de réservations
ADMIN_EMAIL=mattiskhn@gmail.com

# OPTION 1 : Envoi direct via Gmail (Recommandé si vous avez un compte Google)
# 1. Allez sur votre compte Google > Sécurité > Validation en deux étapes
# 2. En bas de page, créez un "Mot de passe d'application" (16 caractères)
# 3. Renseignez-le ci-dessous :
GMAIL_USER=mattiskhn@gmail.com
GMAIL_APP_PASSWORD=

# OPTION 2 : Envoi via Resend (Alternative moderne)
# Créez une clé gratuite sur https://resend.com
RESEND_API_KEY=
EMAIL_FROM="Jirel de Joiry <onboarding@resend.dev>"

